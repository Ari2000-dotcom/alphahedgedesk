# Copy to .env and fill in. Never share .env.

# ===== Kotak Neo =====
# NEO app/web -> More -> Trade API -> Generate application -> copy token
NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=
NEO_MPIN=
# Optional: TOTP secret from "TOTP Registration" (lets the script log in without asking)
NEO_TOTP_SECRET=
# Optional: force a specific MCX token instead of auto-picking front-month CRUDEOIL
KOTAK_CRUDE_TOKEN=

# ===== Upstox =====
# From https://account.upstox.com/developer/apps (used by upstox_login.py)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
# Filled in automatically by upstox_login.py (expires daily, ~3:30 AM IST)
UPSTOX_ACCESS_TOKEN=
# Optional: force an instrument key, e.g. MCX_FO|573422
UPSTOX_CRUDE_KEY=

# ===== Fyers =====
# From https://myapi.fyers.in/dashboard (used by fyers_login.py)
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
# Filled in automatically by fyers_login.py (expires daily, 6:30 AM IST)
FYERS_ACCESS_TOKEN=
# Optional: force a symbol, e.g. MCX:CRUDEOIL26NOVFUT
FYERS_CRUDE_SYMBOL=

# ===== Shoonya (Finvasia) — headless OAuth login (shoonya_auto_login.py) =====
SHOONYA_UID=
SHOONYA_PASSWORD=
# The authenticator key (about 32 letters A-Z and digits 2-7) from Shoonya's TOTP setup
SHOONYA_TOTP_SECRET=
# Client id (API key) of your Shoonya API app, ends in _U
SHOONYA_CLIENT_ID=
# API secret (the long secret code of your Shoonya API app)
SHOONYA_API_SECRET=
# Filled in automatically on login
SHOONYA_ACCESS_TOKEN=

# ===== Nubra (history only) =====
# Registered phone (10 digits), MPIN, and the TOTP secret from Nubra TOTP setup
NUBRA_PHONE=
NUBRA_MPIN=
NUBRA_TOTP_SECRET=
# Any fixed id for this machine; keep it the same every day
NUBRA_DEVICE_ID=hub-1

# ===== Alerts (Telegram) =====
# Bot token from @BotFather, and your chat id (see the setup notes). Leave empty for no alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
